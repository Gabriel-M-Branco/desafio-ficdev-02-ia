# ==============================================================================
# Central Inteligente de Atendimento e Comunicação Institucional - GOV.MT
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example) - RF01 a RF24
# ==============================================================================
# Copie este arquivo para '.env' e configure as chaves conforme o seu cenário:
#   - CENÁRIO A (OpenAI Oficial): Preencha OPENAI_API_KEY e TEXT_PROVIDER=openai
#   - CENÁRIO B (OpenRouter): Preencha OPENROUTER_API_KEY e TEXT_PROVIDER=openrouter
#   - CENÁRIO C (Hugging Face): Preencha HF_TOKEN e TEXT_PROVIDER=huggingface
#   - CENÁRIO D (Local / Adaptador Identificado): Sem chaves; usa CPU/Whisper/Tesseract/SAPI5
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Modelos de Linguagem, Extração e Geração RAG (RF01..RF05, RF14..RF21)
# ------------------------------------------------------------------------------
# Escolha o provedor principal de texto: 'openai', 'openrouter', 'huggingface' ou 'adaptador_simulado'
TEXT_PROVIDER=openai

# Opção 1: OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Opção 2: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false
OPENROUTER_ALLOW_PAID=true
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Opção 3: Hugging Face Serverless (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Fallback opcional de provedor de texto ('none', 'openrouter', 'huggingface', 'openai')
TEXT_FALLBACK_PROVIDER=none

# ------------------------------------------------------------------------------
# 2. Transcrição de Áudio (STT - RF06) e Síntese de Voz (TTS - RF07)
# ------------------------------------------------------------------------------
# STT: 'openai' (whisper-1 em nuvem), 'local' (faster-whisper CPU), 'openrouter' ou 'huggingface'
STT_PROVIDER=local
OPENAI_STT_MODEL=whisper-1
OPENROUTER_STT_MODEL=google/gemini-3.8-flash

# TTS: 'sapi5' (voz nativa do Windows em .wav), 'edge-tts' ou 'openrouter'
TTS_PROVIDER=sapi5
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
OPENROUTER_TTS_VOICE=Zephyr
TTS_LOCAL_VOICE="pt-BR-AntonioNeural"

# ------------------------------------------------------------------------------
# 3. Visão Multimodal e OCR de Documentos (RF08)
# ------------------------------------------------------------------------------
# Provedor de Visão: 'openai' (GPT-4o Vision), 'local' (Tesseract OCR) ou 'openrouter'
VISION_PROVIDER=local
OPENAI_VISION_MODEL=gpt-4o
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash

# ------------------------------------------------------------------------------
# 4. Geração Visual Institucional Híbrida (RF10 - Difusão + Moldura GOV.MT)
# ------------------------------------------------------------------------------
# Provedor de Imagem: 'openai' (gpt-image-1-mini / dall-e-3), 'cloudflare', 'openrouter', 'fal-ai', 'hf-inference' ou 'endpoint'
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_SEED=42
IMAGE_ENDPOINT=
IMAGE_ENDPOINT_TOKEN=

# ------------------------------------------------------------------------------
# 5. Modo de Execução e Interface Oficial (Streamlit - RF20)
# ------------------------------------------------------------------------------
# 'auto': Conecta a APIs quando houver chaves; sem inventar dados caso indisponível
# 'api':  Força chamadas a serviços remotos configurados
# 'mock': Modo isolado sem rede para testes unitários
EXECUTION_MODE=auto
HOST=127.0.0.1
PORT=8501
DEBUG=False
