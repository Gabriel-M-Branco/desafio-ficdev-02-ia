# ==============================================================================
# Central Inteligente de Atendimento e Comunicação Institucional - GOV.MT
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para '.env' e configure as chaves conforme o seu cenário de teste:
#   - CENÁRIO A (Chave Multiuso OpenRouter): Preencha OPENROUTER_API_KEY (faz Texto e Áudio STT).
#   - CENÁRIO B (Token Hugging Face Oficial): Preencha HF_TOKEN (faz Texto e Áudio Whisper HF).
#   - CENÁRIO C (Geração Visual Cloudflare): Preencha CLOUDFLARE_API_TOKEN e ACCOUNT_ID (RF10 FLUX.1).
#   - CENÁRIO D (100% Local / Zero Custo): Deixe em branco; o sistema usa CPU/Whisper/Tesseract/SAPI5.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Modelos de Linguagem e Extração Estruturada (RF02 / RF03 / RF04 / RF05)
# ------------------------------------------------------------------------------
# Escolha o provedor principal de LLM: 'openrouter' ou 'huggingface'
LLM_PROVIDER=openrouter

# Opção 1: OpenRouter (Recomendado para chaves multiuso - https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=true
OPENROUTER_ALLOW_PAID=true
OPENROUTER_MODEL=inclusionai/ling-3.1-flash
# Para modelos gratuitos no OpenRouter, use: meta-llama/llama-3.3-70b-instruct:free

# Opção 2: Hugging Face Serverless (https://huggingface.co/settings/tokens)
HF_TOKEN=


# ------------------------------------------------------------------------------
# 2. Transcrição de Áudio (STT - RF06) e Síntese de Voz (TTS - RF07)
# ------------------------------------------------------------------------------
# STT: 'openrouter' (multimodal via Gemini Flash), 'local' (faster-whisper CPU) ou 'huggingface'
STT_PROVIDER=openrouter
OPENROUTER_STT_MODEL=google/gemini-3.8-flash

# TTS: 'openrouter' (google/gemini-3.8-flash-tts com fallback edge-tts),
#      'edge-tts' (áudio neural online em .mp3) ou 'sapi5' (voz nativa do Windows em .wav)
TTS_PROVIDER=openrouter
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
OPENROUTER_TTS_VOICE=Zephyr
TTS_LOCAL_VOICE="pt-BR-AntonioNeural"


# ------------------------------------------------------------------------------
# 3. Visão Multimodal e OCR de Documentos (RF08)
# ------------------------------------------------------------------------------
# Provedor de Visão: 'openrouter' (VLM multimodal de alta precisão para manuscritos)
#                    ou 'local' (Tesseract OCR / PyMuPDF local)
# Em modo 'openrouter', o Tesseract local atua automaticamente como fallback transparente.
VISION_PROVIDER=openrouter
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash


# ------------------------------------------------------------------------------
# 4. Geração Visual Institucional Híbrida (RF10 - Difusão + Moldura GOV.MT)
# ------------------------------------------------------------------------------
# Provedor de Imagem: 'openrouter', 'cloudflare', 'fal-ai', 'hf-inference' ou 'endpoint'
IMAGE_PROVIDER=openrouter
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# Se usar Cloudflare Workers AI (Gera a arte central em ~2s sem fila):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Se usar Hugging Face / fal-ai (utiliza o HF_TOKEN configurado acima):
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_SEED=42

# Se usar Endpoint HTTP(S) próprio de GPU:
IMAGE_ENDPOINT=
IMAGE_ENDPOINT_TOKEN=


# ------------------------------------------------------------------------------
# 5. Modo de Execução e Servidor Web
# ------------------------------------------------------------------------------
# 'auto': Conecta a APIs quando houver chaves; sem inventar dados caso indisponível
# 'api':  Força chamadas a serviços remotos configurados
# 'mock': Modo isolado sem rede para testes unitários
EXECUTION_MODE=auto
HOST=127.0.0.1
PORT=8000
DEBUG=False
